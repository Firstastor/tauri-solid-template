{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "template",
	"version": "1.0.0",
	"identifier": "git.astor.template",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Template",
				"width": 1600,
				"height": 900,
				"minWidth": 800,
				"minHeight": 600,
				"center": true,
				"decorations": false,
				"resizable": true,
				"transparent": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
